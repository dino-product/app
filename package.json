{
  "name": "dino-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios --device",
    "ios:release": "react-native run-ios --device --mode Release",
    "android": "react-native run-android --active-arch-only",
    "android:release": "react-native run-android --mode release --active-arch-only",
    "pods": "cd ios && bundle exec pod install",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:perf": "reassure",
    "perf:baseline": "reassure --baseline",
    "perf:bundle": "node scripts/check-bundle-size.js",
    "perf:regression": "node scripts/check-perf-regression.js",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:perf && npm run perf:bundle",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^17.6.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "reassure": "^1.6.1",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
