# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# 푸시 (#118). @react-native-firebase 26 은 Firebase iOS SDK 를 CocoaPods 로 받는다.
# SPM 으로 받으면 모든 pod 를 동적 프레임워크로 링크해야 해(use_frameworks! :linkage => :dynamic) 콜드 스타트에 dyld 비용이 붙는다.
# 다른 pod 의 링크 방식(정적 라이브러리)은 그대로 두고, 모듈이 필요한 pod 만 모듈로 낸다:
# FirebaseCore 는 AppDelegate(Swift)가 가져오고, GoogleUtilities 는 Swift pod FirebaseCoreInternal 이 가져온다.
# GoogleUtilities 는 하위 스펙 하나로 적는다 (루트로 적으면 테스트용 하위 스펙까지 들어온다. 모듈 설정은 pod 전체에 걸린다)
$RNFirebaseDisableSPM = true

target 'DinoApp' do
  config = use_native_modules!

  pod 'FirebaseCore', :modular_headers => true
  pod 'GoogleUtilities/Environment', :modular_headers => true

  # 작업 위치 지도 (#67). 카카오맵 SDK v2. 바이너리(xcframework, 동적)라 정적 링크 설정을 바꾸지 않는다.
  # 앱 키는 카카오 로그인과 같은 Info.plist KAKAO_APP_KEY 를 쓴다
  pod 'KakaoMapsSDK', '2.12.19'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 의 iOS SDK 는 배포 타깃 15.0 미만을 받지 않는다. 일부 pod 는 podspec 의 낮은 값(9.0~13.0)을
    # 그대로 들고 와 그 타깃(리소스 번들 포함)에서 빌드가 깨지므로, 앱 최소 버전보다 낮은 것만 그 값으로 올린다
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current && Gem::Version.new(current) < Gem::Version.new(min_ios_version_supported)
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end
  end
end
