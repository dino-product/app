<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. 다크 모드 미지원(#20) — 라이트로 고정한다. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- 스플래시 뒤 첫 프레임 전까지 보이는 배경(#21). 첫 화면 배경색 colors.background[3] 과 같다. -->
        <item name="android:windowBackground">@color/launch_background</item>
        <!-- Android 12+ 시스템 스플래시 배경. 아이콘·새 디자인은 별도 이슈. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/launch_background</item>
    </style>

</resources>
